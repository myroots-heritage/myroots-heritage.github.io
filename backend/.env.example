DATABASE_URL=postgres://myroots:local_dev_only@localhost:5432/myroots
WEB_ORIGIN=http://127.0.0.1:5173
PORT=3001
NODE_ENV=development
# Set true on the online web service to serve frontend/dist alongside /api.
SERVE_FRONTEND=false
# Production defaults to 0.0.0.0; local development defaults to 127.0.0.1.
# HOST=0.0.0.0
# On Render, WEB_ORIGIN may be omitted to use its provided RENDER_EXTERNAL_URL.
# Generate with: openssl rand -base64 32
CONTACT_ENCRYPTION_KEY=
# Separate 32-byte key for workflow archives; keep both keys in a secret manager.
WORKFLOW_ENCRYPTION_KEY=
GOOGLE_DRIVE_FOLDER_ID=1lvN0BWP1yIZM0udGoFZ4XrxYz5SLcjKo
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Operator OAuth refresh token with drive.file scope and access to selected folder.
GOOGLE_REFRESH_TOKEN=
