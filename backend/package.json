{"name":"@myroots/backend","version":"0.1.0","private":true,"type":"module","scripts":{"dev":"tsx watch --env-file-if-exists=.env src/server.ts","build":"tsc --noEmit && esbuild src/server.ts src/worker.ts --bundle --platform=node --format=esm --external:fastify --external:@fastify/* --external:pg --external:zod --outdir=dist --out-extension:.js=.mjs","start":"node --env-file-if-exists=.env dist/server.mjs","workflows":"tsx --env-file-if-exists=.env src/worker.ts","test":"tsx --test src/*.test.ts","db:migrate":"tsx --env-file-if-exists=.env src/migrate.ts"},"dependencies":{"@fastify/cookie":"^11.0.0","@fastify/cors":"^11.0.0","@fastify/helmet":"^13.0.0","@fastify/rate-limit":"^10.3.0","@myroots/shared":"*","fastify":"^5.6.0","pg":"^8.16.0","zod":"^4.1.0"},"devDependencies":{"@types/pg":"^8.15.0","esbuild":"^0.25.0","pg-mem":"^3.0.14","tsx":"^4.20.0"}}